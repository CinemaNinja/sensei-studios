{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sensei-studios",
  "compatibility_date": "2026-08-04",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/film", "/film/",
      "/wood", "/wood/",
      "/woodwork", "/woodwork/",
      "/sculptures", "/sculptures/",
      "/handpan", "/handpan/",
      "/web", "/web/",
      "/story", "/story/",
      "/bio", "/bio/",
      "/work", "/work/",
      "/protocol", "/protocol/",
      "/peace-protocol", "/peace-protocol/",
      "/vision", "/vision/",
      "/estimator", "/estimator/",
      "/scope", "/scope/",
      "/contact", "/contact/"
    ]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "brown@senseistudios.com" }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "SENSEI_ANALYTICS",
      "dataset": "sensei_analytics"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PROTOCOL_PRESENCE",
      "id": "def2ec654a2a4c4c89eaab3236b7bdb0"
    }
  ],
  "vars": {
    "CONTACT_TO": "brown@senseistudios.com",
    "CF_ACCOUNT_ID": "cd07e1c8dff3eafedb2d534a44c9e556",
    "CF_WEB_ANALYTICS_SITE_TAG": "ac8e716aa0b44369aa153cfce7e8e1e2"
  }
}
